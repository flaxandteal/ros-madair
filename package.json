{
  "name": "ros-madair",
  "version": "0.1.0-alpha.14",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "files": [
    "dist",
    "pkg"
  ],
  "module": "./dist/ros-madair.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/ros-madair.js"
    }
  },
  "scripts": {
    "build:wasm": "wasm-pack build crates/ros-madair-client --target web --out-dir ../../pkg --out-name ros_madair --release",
    "build:combined": "wasm-pack build crates/ros-madair-alizarin --target web --out-dir ../../pkg-alizarin --out-name ros_madair_alizarin --release",
    "build:napi": "cd crates/ros-madair-napi && napi build --platform --release",
    "build:js": "vite build && tsc -p tsconfig.build.json",
    "build": "npm run build:wasm && npm run build:js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "puppeteer": "^25.0.4"
  },
  "devDependencies": {
    "typescript": "~5.6.3",
    "vite": "^5.4.18"
  }
}
